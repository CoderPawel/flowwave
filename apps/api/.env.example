# Copy to apps/api/.env for local development. Never commit the real file.
# The password must match infrastructure/docker/.env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://flowwave:change-me-local-only@localhost:5432/flowwave
LOG_LEVEL=info
# Swagger UI at /docs. Defaults to on, except when NODE_ENV=production.
SWAGGER_ENABLED=true
# Comma-separated list of allowed browser origins (the web panel).
CORS_ORIGINS=http://localhost:3001
# Authentication (decision 0013). Access tokens: 60-3600 seconds; refresh tokens: 1-90 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Email and password registration. Defaults to on, except when NODE_ENV=production.
AUTH_REGISTRATION_ENABLED=true
# Number of reverse proxies in front of the API (0 when clients connect directly).
TRUST_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
# Export worker and retention job (decision 0014).
BACKGROUND_JOBS_ENABLED=true
