{
  "name": "@flowwave/api",
  "version": "0.1.0",
  "private": true,
  "description": "FlowWave sync API (NestJS, Prisma, PostgreSQL).",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run prisma:generate && npm run clean && tsc -p tsconfig.json",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "start": "node --enable-source-maps dist/src/main.js",
    "dev": "npm run build && npm start",
    "openapi:generate": "npm run build && node dist/src/scripts/generateOpenApi.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.3",
    "prisma": "^7.10.1"
  }
}
