# Optional: enables the API tests that talk to a real PostgreSQL database.
# Export these variables before `npm test -w @flowwave/api`; the tests never read .env files.
FLOWWAVE_TEST_DATABASE_URL=postgresql://flowwave:change-me-local-only@localhost:5432/flowwave_test
# Used by scripts/verify-migrations.sh. Point it at a disposable database.
DATABASE_URL=postgresql://flowwave:change-me-local-only@localhost:5432/flowwave_test
