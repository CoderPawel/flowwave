// FlowWave database schema. Models are added in roadmap step 3; until then the
// schema lives in db/migrations (see docs/architecture/0010-prisma-schema-and-data-access.md).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
