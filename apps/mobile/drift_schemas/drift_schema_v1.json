  "fixed_sql": [
    {
      "name": "local_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_settings\" (\"id\" INTEGER NOT NULL, \"theme_preference\" TEXT NOT NULL DEFAULT 'system', \"language_preference\" TEXT NOT NULL DEFAULT 'system', \"onboarding_completed_at_utc\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "consent_decisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"consent_decisions\" (\"id\" TEXT NOT NULL, \"consent_type\" TEXT NOT NULL, \"source_id\" TEXT NULL, \"state\" TEXT NOT NULL, \"scopes\" TEXT NOT NULL, \"policy_version\" TEXT NOT NULL, \"decided_at_utc\" TEXT NOT NULL, \"decided_time_zone\" TEXT NOT NULL, \"decided_utc_offset_minutes\" INTEGER NOT NULL, \"synced_at_utc\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox_operations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox_operations\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"created_at_utc\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at_utc\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"last_error\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
